{
  "name": "swe-agent",
  "version": "0.1.0",
  "description": "Minimal SWE agent in TypeScript: task scheduling, tool calling loop, terminal & file I/O",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "swe-agent": "src/demo.ts"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "task": "tsx src/run.ts",
    "web": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.0",
    "dotenv": "^16.4.5",
    "openai": "^4.71.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
